# syntax=docker/dockerfile:1

ARG PYTHON_VERSION=3.13.7
FROM python:${PYTHON_VERSION}-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv 
    
ENV PATH="/opt/venv/bin:${PATH}"
ARG UID=10001

RUN adduser \
    --disabled-password \
    --gecos "" \
    --home /home/appuser \
    --uid "${UID}" \
    appuser

RUN pip install --no-cache-dir uv

RUN mkdir -p /opt/venv /app \
    && chown -R appuser:appuser /opt/venv /app


WORKDIR /app

# Preserve the same relative paths used by api/pyproject.toml.
COPY --chown=appuser:appuser packages/sprite_core/ packages/sprite_core/
COPY --chown=appuser:appuser api/ api/

USER appuser
WORKDIR /app/api

RUN uv sync --frozen --no-dev

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--forwarded-allow-ips", "*"]