# syntax=docker/dockerfile:1

ARG PYTHON_VERSION=3.13.7
FROM python:${PYTHON_VERSION}-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

    
ARG UID=10001

RUN adduser \
    --disabled-password \
    --gecos "" \
    --home /home/appuser \
    --uid "${UID}" \
    appuser

RUN pip install --no-cache-dir uv

WORKDIR /app

# Preserve the same relative paths used by api/pyproject.toml.
COPY --chown=appuser:appuser packages/sprite_core/ packages/sprite_core/
COPY --chown=appuser:appuser api/ api/

WORKDIR /app/api

RUN uv sync --frozen --no-dev

USER appuser

EXPOSE 8000

CMD ["sh", "-c", "exec uv run uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8000} --forwarded-allow-ips '*'"]